{
  "name": "rag-abrsm-exam",
  "version": "1.0.0",
  "description": "RAG chatbot for ABRSM piano exam syllabus Q&A with retrieval evaluation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/11-plus/*.test.js",
    "test:loader": "node --test test/11-plus/01-document-loader.test.js",
    "test:embedding": "node --test test/11-plus/02-embedding.test.js",
    "test:vector": "node --test test/11-plus/03-vector-store.test.js",
    "test:chat": "node --test test/11-plus/04-chat-service.test.js",
    "test:evaluator": "node --test test/11-plus/05-evaluator.test.js",
    "test:chunking": "node --test test/11-plus/06-chunking-strategy.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.100.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
